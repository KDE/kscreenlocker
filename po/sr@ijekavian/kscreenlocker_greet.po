#: fallbacktheme/Greeter.qml:59
msgid "Warning: Caps Lock on"
msgstr "Упозорење: CapsLock укључен"

#: fallbacktheme/Greeter.qml:75
msgid "The session is locked"
msgstr "Сесија је закључана"

#: fallbacktheme/Greeter.qml:76
msgid "The session has been locked by %1"
msgstr "Сесију закључа %1"

#: fallbacktheme/Greeter.qml:83
msgid "Password"
msgstr "Лозинка"

#: fallbacktheme/Greeter.qml:101
msgid "(or place your fingerprint on the reader)"
msgstr "(или ставите прст на читач)"

#: fallbacktheme/Greeter.qml:107
msgid "(or use your smartcard)"
msgstr "(или употријебите своју смарт-картицу)"

#: fallbacktheme/Greeter.qml:116
msgid "&Switch Users"
msgstr "&Промијени кориснике"

#: fallbacktheme/Greeter.qml:123
msgid "Un&lock"
msgstr "&Откључај"

#: fallbacktheme/Greeter.qml:135
msgid "Unlocking failed"
msgstr "Откључавање пропало"

# rewrite-msgid: /KDE Plasma Workspaces//
#: main.cpp:102
#, kde-format
msgid "Greeter for the KDE Plasma Workspaces Screen locker"
msgstr "Поздравни дијалог закључавача екрана"

#: main.cpp:106
#, kde-format
msgid "Starts the greeter in testing mode"
msgstr "Покреће поздравни дијалог у пробном режиму"

#: main.cpp:109
#, kde-format
msgid "Starts the greeter with the selected shell theme (only in Testing mode)"
msgstr ""
"Покреће поздравни дијалог са изабраном темом шкољке (само у пробном режиму)"

#: main.cpp:113
#, kde-format
msgid "Lock immediately, ignoring any grace time etc."
msgstr "Закључај одмах, занемаривши допусно вријеме, итд."

#: main.cpp:115
#, kde-format
msgid "Delay till the lock user interface gets shown in milliseconds."
msgstr "Застој прије приказивања закључаног сучеља, у милисекундама."

#: main.cpp:118
#, kde-format
msgid "Don't show any lock user interface."
msgstr "Без приказивања закључаног сучеља."

