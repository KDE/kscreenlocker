#: main.cpp:113
#, kde-format
msgid "Greeter for the KDE Plasma Workspaces Screen locker"
msgstr "KDE Plasma Workspaces Screen locker इत्यस्य अभिवादनम्"

#: main.cpp:117
#, kde-format
msgid "Starts the greeter in testing mode"
msgstr "परीक्षणविधाने अभिवादकं आरभते"

#: main.cpp:120
#, kde-format
msgid "Starts the greeter with the selected shell theme (only in Testing mode)"
msgstr "चयनितेन शेल् विषयेण सह अभिवादकं आरभते (केवलं Testing मोड् मध्ये)"

#: main.cpp:124
#, kde-format
msgid "Lock immediately, ignoring any grace time etc."
msgstr "तत्क्षणं तालान् स्थापयन्तु, कस्यापि अनुग्रहसमयादिना अवहेलना।"

#: main.cpp:126
#, kde-format
msgid "Delay till the lock user interface gets shown in milliseconds."
msgstr "यावत् lock उपयोक्तृ-अन्तरफलकं मिलीसेकेण्ड्-मध्ये दर्शितं न भवति तावत् विलम्बं कुर्वन्तु ।"

#: main.cpp:129
#, kde-format
msgid "Don't show any lock user interface."
msgstr "किमपि लॉक् उपयोक्तृ-अन्तरफलकं न दर्शयन्तु ।"

