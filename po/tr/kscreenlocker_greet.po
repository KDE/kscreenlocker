#: fallbacktheme/Greeter.qml:59
msgid "Warning: Caps Lock on"
msgstr "Uyarı: Büyük Harf düğmesi açık"

#: fallbacktheme/Greeter.qml:75
msgid "The session is locked"
msgstr "Oturum kilitli"

#: fallbacktheme/Greeter.qml:76
msgid "The session has been locked by %1"
msgstr "Oturum %1 tarafından kilitlendi"

#: fallbacktheme/Greeter.qml:83
msgid "Password"
msgstr "Parola"

#: fallbacktheme/Greeter.qml:101
msgid "(or place your fingerprint on the reader)"
msgstr "(veya parmağınızı okuyucuya taratın)"

#: fallbacktheme/Greeter.qml:107
msgid "(or use your smartcard)"
msgstr "(veya akıllı kartınızı kullanın)"

#: fallbacktheme/Greeter.qml:116
msgid "&Switch Users"
msgstr "&Kullanıcı Değiştir"

#: fallbacktheme/Greeter.qml:123
msgid "Un&lock"
msgstr "Kilidi &Aç"

#: fallbacktheme/Greeter.qml:135
msgid "Unlocking failed"
msgstr "Kilit açılamadı"

#: main.cpp:113
#, kde-format
msgid "Greeter for the KDE Plasma Workspaces Screen locker"
msgstr "KDE Plasma Çalışma Alanı ekran kilitleyicisi için karşılayıcı"

#: main.cpp:117
#, kde-format
msgid "Starts the greeter in testing mode"
msgstr "Karşılayıcıyı sınama kipinde başlatır"

#: main.cpp:120
#, kde-format
msgid "Starts the greeter with the selected shell theme (only in Testing mode)"
msgstr ""
"Karşılayıcıyı seçili kabuk temasını kullanarak başlatır (yalnızca sınama "
"kipinde)"

#: main.cpp:124
#, kde-format
msgid "Lock immediately, ignoring any grace time etc."
msgstr "Erteleme süresini yok sayarak hemen kilitleyin."

#: main.cpp:126
#, kde-format
msgid "Delay till the lock user interface gets shown in milliseconds."
msgstr "Milisaniye türünden kilitli arayüzün gösterilmesi için gecikme zamanı."

#: main.cpp:129
#, kde-format
msgid "Don't show any lock user interface."
msgstr "Bir kilit kullanıcı arayüzü göstermeyin."

