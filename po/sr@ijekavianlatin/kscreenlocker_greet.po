#: fallbacktheme/Greeter.qml:59
msgid "Warning: Caps Lock on"
msgstr "Upozorenje: CapsLock uključen"

#: fallbacktheme/Greeter.qml:75
msgid "The session is locked"
msgstr "Sesija je zaključana"

#: fallbacktheme/Greeter.qml:76
msgid "The session has been locked by %1"
msgstr "Sesiju zaključa %1"

#: fallbacktheme/Greeter.qml:83
msgid "Password"
msgstr "Lozinka"

#: fallbacktheme/Greeter.qml:101
msgid "(or place your fingerprint on the reader)"
msgstr "(ili stavite prst na čitač)"

#: fallbacktheme/Greeter.qml:107
msgid "(or use your smartcard)"
msgstr "(ili upotrijebite svoju smart-karticu)"

#: fallbacktheme/Greeter.qml:116
msgid "&Switch Users"
msgstr "&Promijeni korisnike"

#: fallbacktheme/Greeter.qml:123
msgid "Un&lock"
msgstr "&Otključaj"

#: fallbacktheme/Greeter.qml:135
msgid "Unlocking failed"
msgstr "Otključavanje propalo"

# rewrite-msgid: /KDE Plasma Workspaces//
#: main.cpp:102
#, kde-format
msgid "Greeter for the KDE Plasma Workspaces Screen locker"
msgstr "Pozdravni dijalog zaključavača ekrana"

#: main.cpp:106
#, kde-format
msgid "Starts the greeter in testing mode"
msgstr "Pokreće pozdravni dijalog u probnom režimu"

#: main.cpp:109
#, kde-format
msgid "Starts the greeter with the selected shell theme (only in Testing mode)"
msgstr ""
"Pokreće pozdravni dijalog sa izabranom temom školjke (samo u probnom režimu)"

#: main.cpp:113
#, kde-format
msgid "Lock immediately, ignoring any grace time etc."
msgstr "Zaključaj odmah, zanemarivši dopusno vrijeme, itd."

#: main.cpp:115
#, kde-format
msgid "Delay till the lock user interface gets shown in milliseconds."
msgstr "Zastoj prije prikazivanja zaključanog sučelja, u milisekundama."

#: main.cpp:118
#, kde-format
msgid "Don't show any lock user interface."
msgstr "Bez prikazivanja zaključanog sučelja."

#: pamauthenticatormodel.cpp:51
#, kde-format
msgctxt "authentication type in unlock dialogs"
msgid "Password"
msgstr "Lozinka"

#: pamauthenticatormodel.cpp:60
